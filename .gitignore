# --- Project data & secrets (never commit) ---
# Leading slash = only the top-level data/ folder (not src/fdda/data/, which is code)
/data/
.env
.env.*
!.env.example

# --- Power BI ---
# A .pbix embeds the imported data (H&M licence: no redistribution): commit the PDF and
# screenshots instead.
*.pbix
*.pbix.bak
*.pbit.bak
~$*.pbix
*.pbix.backup

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

