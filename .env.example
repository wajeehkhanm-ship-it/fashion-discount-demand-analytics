# Copy this file to .env and fill in your values. .env is git-ignored.

# Kaggle: kaggle.com -> Settings -> API -> "Create New Token".
# New-style tokens start with KGAT_ and go here:
KAGGLE_API_TOKEN=
# Older accounts get a kaggle.json with a username + key instead; use these two lines then.
KAGGLE_USERNAME=
KAGGLE_KEY=

# LLM provider key (Phase 6)
LLM_API_KEY=
